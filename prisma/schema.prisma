generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  filiere       String    @default("Général")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  folders          Folder[]
  courses          Course[]
  sessions         Session[]
  accounts         Account[]
  suggestions      Suggestion[]
  flashcardReviews FlashcardReview[]
  studySessions    StudySession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]
  exercises FolderExercise[]
}

model FolderExercise {
  id        String   @id @default(cuid())
  folderId  String
  exercises Json
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model Course {
  id              String   @id @default(cuid())
  title           String
  rawContent      String
  structuredContent Json?
  keywords        Json?
  status          String   @default("processing")
  userId          String
  folderId        String?
  subject         String   @default("Général")
  niveau          String   @default("L1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?       @relation(fields: [folderId], references: [id])
  quizzes    Quiz[]
  flashcards Flashcard[]
  scores     Score[]
  chunks     CourseChunk[]
}

model Quiz {
  id        String   @id @default(cuid())
  courseId  String
  questions Json
  createdAt DateTime @default(now())

  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  results QuizResult[]
}

model QuizResult {
  id        String   @id @default(cuid())
  quizId    String
  score     Int
  total     Int
  answers   Json
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id       String @id @default(cuid())
  courseId String
  question String
  answer   String

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]
}

model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  userId      String
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetition  Int      @default(0)
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, userId])
  @@index([userId, nextReview])
}

model StudySession {
  id           String   @id @default(cuid())
  userId       String
  cardsStudied Int      @default(0)
  date         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // [FIX #9] Contrainte pour éviter les doublons de session par jour
  @@index([userId, date])
}

model Score {
  id        String   @id @default(cuid())
  courseId  String
  userId    String?
  score     Int
  source    String?  @default("quiz")
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Suggestion {
  id        String   @id @default(cuid())
  userId    String
  content   String
  public    Boolean  @default(false)
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseChunk {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contenu   String  @db.Text
  embedding Unsupported("vector(768)")?
  ordre     Int

  @@index([courseId])
}

model Methodo {
  id        String   @id @default(cuid())
  courseId  String
  type      String
  content   Json
  createdAt DateTime @default(now())

  @@index([courseId])
}

model ExerciceGuide {
  id            String   @id @default(cuid())
  courseId      String
  userId        String
  type          String   @default("cas_pratique")
  enonce        String   @db.Text
  etapeActuelle Int      @default(0)
  historique    Json     @default("[]")
  termine       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([courseId, userId])
}

model Signalement {
  id          String   @id @default(cuid())
  userId      String
  type        String
  refId       String
  contenuIA   String   @db.Text
  probleme    String
  commentaire String?  @db.Text
  niveau      String?
  createdAt   DateTime @default(now())
}
